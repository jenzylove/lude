{
  "name": "lude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server tests index.html vite.config.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.1.5"
  }
}
